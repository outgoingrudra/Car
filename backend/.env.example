# Local MongoDB works if MongoDB is installed and running on your computer.
MONGODB_URI=mongodb://127.0.0.1:27017
JWT_SECRET=replace-with-a-long-random-secret
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Gmail address used to send verification codes.
ADMIN_EMAIL=
# Google App Password for this Gmail account (not your normal password).
ADMIN_APP_PASSWORD=
PORT=3000
